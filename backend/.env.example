# Every variable the backend reads. Copy to .env and edit as needed; all of
# these have working defaults, so .env is optional in development.

# Absolute origin used for og:url and og:image. Must be the public URL in prod.
PETALPOST_PUBLIC_BASE_URL=http://localhost:5173

# Where the SQLite file and the rendered OG cache live.
PETALPOST_DATA_DIR=./data

# Override to point at another database (e.g. postgresql+psycopg://...).
# PETALPOST_DATABASE_URL=

# Built frontend served in production.
PETALPOST_FRONTEND_DIST=../frontend/dist

# Abuse limits.
PETALPOST_MAX_BODY_BYTES=65536
PETALPOST_RATE_LIMIT_ENABLED=true
PETALPOST_RATE_LIMIT_CREATE=20/minute
